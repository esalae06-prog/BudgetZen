
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inscription - BudgetZen</title>
    <link rel="stylesheet" href="/styles.css">
</head>

<body>
    <main class="container">
        <div class="card">

            <h1>Créer un compte BudgetZen</h1>
            <p>Bienvenue ! Créez votre compte pour gérer votre budget.</p>

            <!-- Affichage des erreurs du serveur -->
            <% if (erreur) { %>
                <p class="erreur" role="alert">
                    <%= erreur %>
                </p>
            <% } %>

            <!-- Formulaire d'inscription -->
            <form action="/inscription" method="POST">

                <!-- Protection CSRF -->
                <input
                    type="hidden"
                    name="_csrf"
                    value="<%= csrfToken %>"
                >

                <!-- Nom -->
                <label for="nom">Nom :</label>
                <input
                    type="text"
                    id="nom"
                    name="nom"
                    placeholder="Entrez votre nom"
                    minlength="2"
                    maxlength="80"
                    autocomplete="name"
                    required
                >

                <!-- Email -->
                <label for="email">Email :</label>
                <input
                    type="email"
                    id="email"
                    name="email"
                    placeholder="exemple@email.com"
                    maxlength="254"
                    autocomplete="email"
                    required
                >

                <!-- Mot de passe -->
                <label for="password">Mot de passe :</label>
                <input
                    type="password"
                    id="password"
                    name="password"
                    placeholder="Créez un mot de passe fort"
                    minlength="16"
                    pattern="(?=.*[A-Za-z])(?=.*[0-9])(?=.*[^A-Za-z0-9\s]).{16,}"
                    title="Au moins 16 caractères, avec une lettre, un chiffre et un caractère spécial."
                    autocomplete="new-password"
                    aria-describedby="password-help"
                    required
                >

                <!-- Conditions du mot de passe -->
                <div class="password-info" id="password-help">
                    <strong>Votre mot de passe doit contenir :</strong>
                    <ul>
                        <li>Au moins 16 caractères</li>
                        <li>Au moins une lettre</li>
                        <li>Au moins un chiffre (0-9)</li>
                        <li>Au moins un caractère spécial (@, #, !, $...)</li>
                    </ul>
                </div>

                <!-- Confirmation du mot de passe -->
                <label for="confirmation">
                    Confirmer le mot de passe :
                </label>
                <input
                    type="password"
                    id="confirmation"
                    name="confirmation"
                    placeholder="Retapez votre mot de passe"
                    minlength="16"
                    autocomplete="new-password"
                    required
                >

                <p id="confirmation-error"
                   class="erreur"
                   role="alert"
                   hidden>
                    Les mots de passe ne correspondent pas.
                </p>

                <!-- Bouton inscription -->
                <button type="submit">
                    S'inscrire
                </button>

            </form>

            <p>
                Vous avez déjà un compte ?
                <a href="/connexion">Se connecter</a>
            </p>

        </div>
    </main>

    <script>
        const formulaire = document.querySelector("form");
        const password = document.getElementById("password");
        const confirmation = document.getElementById("confirmation");
        const messageErreur = document.getElementById(
            "confirmation-error"
        );

        function verifierConfirmation() {
            const identiques =
                password.value === confirmation.value;

            confirmation.setCustomValidity(
                identiques ? "" : "Les mots de passe ne correspondent pas."
            );

            messageErreur.hidden = identiques;
        }

        confirmation.addEventListener("input", verifierConfirmation);
        password.addEventListener("input", () => {
            if (confirmation.value) verifierConfirmation();
        });

        formulaire.addEventListener("submit", verifierConfirmation);
    </script>
</body>
</html>
